<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0nppvsr" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="solving_quadratic_equation" name="Solving a quadratic equation" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0endm01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0endm01" sourceRef="StartEvent_1" targetRef="Activity_0goynks" />
    <bpmn:manualTask id="Activity_0goynks" name="Set Initial Values A,B,C">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="varA">${1}</camunda:outputParameter>
          <camunda:outputParameter name="varB">7</camunda:outputParameter>
          <camunda:outputParameter name="varC">${12.0}</camunda:outputParameter>
          <camunda:outputParameter name="varChannelTerms">
            <camunda:map>
              <camunda:entry key="channelSubscribed">${false}</camunda:entry>
              <camunda:entry key="channelInvited">${false}</camunda:entry>
              <camunda:entry key="channelShared">${false}</camunda:entry>
              <camunda:entry key="channelLiked">${false}</camunda:entry>
              <camunda:entry key="channelCommented">${false}</camunda:entry>
            </camunda:map>
          </camunda:outputParameter>
          <camunda:outputParameter name="varPlay">${true}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0endm01</bpmn:incoming>
      <bpmn:outgoing>Flow_14wz1yc</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_14wz1yc" sourceRef="Activity_0goynks" targetRef="Activity_0vligg9" />
    <bpmn:serviceTask id="Activity_0vligg9" name="Calculate Discriminant" camunda:expression="${(varB * varB) - (4 * varA * varC)}" camunda:resultVariable="varDiscriminant">
      <bpmn:incoming>Flow_14wz1yc</bpmn:incoming>
      <bpmn:incoming>Flow_1uhef1r</bpmn:incoming>
      <bpmn:outgoing>Flow_0l5741n</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0z65ij8" default="Flow_1loqn5s">
      <bpmn:incoming>Flow_0l5741n</bpmn:incoming>
      <bpmn:outgoing>Flow_1sqzetc</bpmn:outgoing>
      <bpmn:outgoing>Flow_1loqn5s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tmnkkj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0l5741n" sourceRef="Activity_0vligg9" targetRef="Gateway_0z65ij8" />
    <bpmn:sequenceFlow id="Flow_1sqzetc" name="D &#62; 0" sourceRef="Gateway_0z65ij8" targetRef="Activity_041v0qd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${varDiscriminant &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1loqn5s" name="D = 0" sourceRef="Gateway_0z65ij8" targetRef="Activity_1tdpav4" />
    <bpmn:sequenceFlow id="Flow_1tmnkkj" name="D &#60; 0" sourceRef="Gateway_0z65ij8" targetRef="Activity_1bmoer8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${varDiscriminant &lt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1tdpav4" name="Calculate One Real Root" camunda:expression="${(-varB) / (2 * varA)}" camunda:resultVariable="varX">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="resultText">One Real Root found: x = ${varX} for varA == ${varA}, varB == ${varB}, varC == ${varC}, Discriminant = ${varDiscriminant}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1loqn5s</bpmn:incoming>
      <bpmn:outgoing>Flow_1y0o8zf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Activity_1bmoer8" name="No Real Roots">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="resultText">No Real Roots for varA == ${varA}, varB == ${varB}, varC == ${varC}, because of varDiscriminant = ${varDiscriminant}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tmnkkj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ewhqs0</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:scriptTask id="Activity_041v0qd" name="Calculate Two Real Roots" scriptFormat="feel" camunda:resultVariable="varRoots">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="resultText">Two Real Roots found: x1 = ${varRoots.varX1}, x2 = ${varRoots.varX2} for varA == ${varA}, varB == ${varB}, varC == ${varC}, Discriminant = ${varDiscriminant}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1sqzetc</bpmn:incoming>
      <bpmn:outgoing>Flow_17xt401</bpmn:outgoing>
      <bpmn:script>{
  varX1: (-number(varB) + sqrt(varDiscriminant)) / (2 * varA),
  varX2: (-number(varB) - sqrt(varDiscriminant)) / (2 * varA)
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_18ql7ot">
      <bpmn:incoming>Flow_0ewhqs0</bpmn:incoming>
      <bpmn:incoming>Flow_1y0o8zf</bpmn:incoming>
      <bpmn:incoming>Flow_17xt401</bpmn:incoming>
      <bpmn:outgoing>Flow_1w9iedi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ewhqs0" sourceRef="Activity_1bmoer8" targetRef="Gateway_18ql7ot" />
    <bpmn:sequenceFlow id="Flow_1y0o8zf" sourceRef="Activity_1tdpav4" targetRef="Gateway_18ql7ot" />
    <bpmn:sequenceFlow id="Flow_17xt401" sourceRef="Activity_041v0qd" targetRef="Gateway_18ql7ot" />
    <bpmn:sequenceFlow id="Flow_1w9iedi" sourceRef="Gateway_18ql7ot" targetRef="Activity_1hvvmof" />
    <bpmn:userTask id="Activity_14436by" name="Open Cockpit and Play!">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1eg31kl</bpmn:incoming>
      <bpmn:outgoing>Flow_1l2zxlh</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0mp2bvy" default="Flow_0t2a4pp">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;delegateInput&#34;, varPlay ? &#34;Yay! The user likes the channel 😊&#34; : &#34;Oh no!!! The user does not like the channel 😔&#34;)}" event="start" />
        <camunda:executionListener delegateExpression="${logTextDelegate}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06uwv1x</bpmn:incoming>
      <bpmn:outgoing>Flow_0t2a4pp</bpmn:outgoing>
      <bpmn:outgoing>Flow_1uhef1r</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1l2zxlh" sourceRef="Activity_14436by" targetRef="Activity_0axmzdo" />
    <bpmn:endEvent id="Event_1d2htgq">
      <bpmn:incoming>Flow_0t2a4pp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0t2a4pp" name="Complete&#10;(varPlay == false)" sourceRef="Gateway_0mp2bvy" targetRef="Event_1d2htgq" />
    <bpmn:sequenceFlow id="Flow_1uhef1r" name="Play&#10;(varPlay == true)" sourceRef="Gateway_0mp2bvy" targetRef="Activity_0vligg9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${varPlay}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1eg31kl" sourceRef="Activity_1hvvmof" targetRef="Activity_14436by" />
    <bpmn:serviceTask id="Activity_1hvvmof" name="Log To Console" camunda:delegateExpression="${logTextDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="delegateInput">${resultText}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1w9iedi</bpmn:incoming>
      <bpmn:outgoing>Flow_1eg31kl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_06uwv1x" sourceRef="Activity_0axmzdo" targetRef="Gateway_0mp2bvy">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0axmzdo" name="Check Re-Play Condition" camunda:expression="${varPlay &#38;&#38; varItem}" camunda:resultVariable="varPlay">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1l2zxlh</bpmn:incoming>
      <bpmn:outgoing>Flow_06uwv1x</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${varChannelTerms.values()}" camunda:elementVariable="varItem" />
    </bpmn:serviceTask>
  </bpmn:process>
